      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__codegraph__*",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run build *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm run test *)",
      "PowerShell(pnpm run lint *)",
      "PowerShell(pnpm run build *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(ruff check *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose config --quiet)",
      "Bash(docker compose exec -T backend ruff check .)",
      "Bash(docker compose exec -T backend pytest -q)",
      "Bash(git push -u origin HEAD:refs/heads/agent/*)",
      "Bash(git push -u origin HEAD:refs/heads/feature/*)",
      "Bash(git push -u origin HEAD:refs/heads/fix/*)",
      "Bash(git push origin HEAD:refs/heads/agent/*)",
      "Bash(git push origin HEAD:refs/heads/feature/*)",
      "Bash(git push origin HEAD:refs/heads/fix/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue edit *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git rebase *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve *)",
      "Bash(gh api *merge*)",
      "Bash(git merge *)",
      "PowerShell(gh pr review * --approve *)",
      "PowerShell(gh api *merge*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin HEAD:refs/heads/main *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin HEAD:main *)",
      "PowerShell(git push origin HEAD:refs/heads/main *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(secrets/**)",
      "Read(.aws/credentials)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(credentials.json)",
      "Read(service-account*.json)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa)",
      "Read(id_ed25519)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-python-heredoc.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
